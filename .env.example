# Google OAuth Credentials (Tạo tại https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# NextAuth Secret (Tạo ngẫu nhiên bằng lệnh: npx auth secret hoặc openssl rand -base64 32)
AUTH_SECRET=your-random-auth-secret-key-at-least-32-chars

# URL chạy ứng dụng (Mặc định local: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000
